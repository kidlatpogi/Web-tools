---
import Layout from '../layouts/Layout.astro';
import ShapeGrid from '../components/ShapeGrid.tsx';
import { Home, Compass, ArrowUpRight } from 'lucide-react';
---

<Layout
  title="404 — Page Not Found | Web-Tools"
  description="The requested developer resource or page does not exist on Web-Tools."
>
  <!-- Background ShapeGrid -->
  <div class="fixed inset-0 z-0 pointer-events-none">
    <ShapeGrid
      client:load
      speed={0}
      squareSize={55}
      borderColor="rgba(51, 65, 85, 0.06)"
      hoverFillColor="rgba(196, 73, 0, 0.12)"
      shape="square"
      hoverTrailAmount={6}
      gradientColor="#f8f8f8"
    />
  </div>

  <main class="w-full min-h-screen flex flex-col items-center justify-center relative z-10 px-4 sm:px-6 py-12 text-center">
    <div class="max-w-xl w-full mx-auto p-8 sm:p-12 rounded-3xl bg-white/90 border-2 border-slate-200/90 backdrop-blur-md shadow-2xl flex flex-col items-center">
      
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent mb-6">
        <Compass className="w-3.5 h-3.5" />
        <span class="font-mono text-[11px] uppercase font-bold tracking-widest">
          Error 404 &bull; Resource Missing
        </span>
      </div>

      <!-- Large 404 Display Typography -->
      <div class="flex items-center justify-center gap-1 mb-2 select-none">
        <span class="font-sans text-7xl sm:text-8xl font-black text-black tracking-tighter leading-none">
          4
        </span>
        <span class="font-clash-semibold text-7xl sm:text-8xl font-semibold text-accent tracking-tighter leading-none">
          0
        </span>
        <span class="font-sans text-7xl sm:text-8xl font-black text-black tracking-tighter leading-none">
          4
        </span>
      </div>

      <!-- Headline -->
      <h1 class="font-clash-semibold text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mb-3">
        Page Not Found
      </h1>

      <!-- Description -->
      <p class="font-sans text-sm sm:text-base text-slate-600 leading-relaxed max-w-md mb-8">
        The tool, pathway, or link you are looking for has moved, been renamed, or does not exist in our curated registry.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 w-full">
        <a
          href="/"
          class="cursor-target inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full bg-black hover:bg-accent text-white font-mono text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5"
        >
          <Home className="w-4 h-4" />
          Back to Directory
        </a>
        <a
          href="https://portfolio.kidlat.workers.dev/"
          target="_blank"
          rel="noopener noreferrer"
          class="cursor-target inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-white/90 border-2 border-slate-200 hover:border-accent hover:text-accent text-slate-800 font-mono text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-xs hover:shadow-md hover:-translate-y-0.5"
        >
          Visit Portfolio
          <ArrowUpRight className="w-4 h-4" />
        </a>
      </div>
    </div>
  </main>
</Layout>
