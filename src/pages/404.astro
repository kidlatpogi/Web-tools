---
import Layout from '../layouts/Layout.astro';
import ShapeGrid from '../components/ShapeGrid.tsx';
import TargetCursor from '../components/TargetCursor.tsx';
import { ArrowLeft, Home, Compass } from 'lucide-react';
---

<Layout
  title="404 — Page Not Found | Web-Tools"
  description="The requested developer resource or page does not exist on Web-Tools."
>
  <!-- Background ShapeGrid -->
  <div class="fixed inset-0 z-0 pointer-events-none">
    <ShapeGrid
      client:load
      speed={0}
      squareSize={55}
      borderColor="rgba(51, 65, 85, 0.06)"
      hoverFillColor="rgba(196, 73, 0, 0.12)"
      shape="square"
      hoverTrailAmount={6}
      gradientColor="#f8f8f8"
    />
  </div>

  <TargetCursor client:load targetSelector="a, button, .cursor-target" />

  <main class="w-full min-h-screen flex flex-col items-center justify-center relative z-10 px-4 text-center">
    <div class="max-w-xl mx-auto p-8 sm:p-12 rounded-3xl bg-white/90 border-2 border-slate-200 backdrop-blur-md shadow-2xl flex flex-col items-center">
      
      <!-- 404 Visual Glyph -->
      <div class="w-16 h-16 rounded-2xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent mb-6 shadow-sm">
        <Compass className="w-8 h-8 animate-spin" style={{ animationDuration: '12s' }} />
      </div>

      <span class="font-mono text-xs uppercase font-bold tracking-widest text-accent mb-2">
        Error 404 &bull; Resource Missing
      </span>

      <h1 class="font-clash-semibold text-4xl sm:text-5xl font-black text-slate-900 tracking-tight mb-3">
        Page Not Found
      </h1>

      <p class="font-sans text-sm sm:text-base text-slate-600 leading-relaxed max-w-md mb-8">
        The tool, pathway, or link you are looking for has moved or does not exist in our curated registry.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="cursor-target inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent hover:bg-black text-white font-mono text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-0.5"
        >
          <Home className="w-4 h-4" />
          Back to Directory
        </a>
      </div>
    </div>
  </main>
</Layout>
